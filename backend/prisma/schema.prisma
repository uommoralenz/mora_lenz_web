// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// create database schema

enum Role {
  ADMIN  // developer / president / sinior treasurer
  HR
  Event
  NewsTeam
  CreativeDesign
}

// user model
model User {
  id String @id @default(uuid())
  email String @unique
  password String
  firstName String?
  lastName String?
  role Role
  refreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

// event model
model Event {
  id String @id @default(uuid())
  title String
  description String
  date DateTime
  location String
  imageUrls String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, title])
  @@map("events")

}

// member model
model Member {
  id String @id @default(uuid())
  firstName String
  lastName String
  pillerorPannel String?
  position String
  bio String?
  photoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([pillerorPannel, position])
  @@map("members")
}