###############################################################################
# Mora Lenz admin panel — environment
#
# On Vercel: Project Settings -> Environment Variables. Add each of these for
# the Production environment (and Preview, if you use preview deployments).
#
# NOTE: none of these are NEXT_PUBLIC_*, and that is deliberate. Every call to
# the Laravel API happens on the server, so the API URL and the admin's token
# never reach the browser.
###############################################################################

# Base URL of the Laravel admin API, with no trailing slash.
# This is your university site's address followed by /api/admin
LARAVEL_API_URL=https://moralenz.uom.lk/index.php/api/admin

# Name of the cookie holding the session token. Leave as-is unless it clashes.
SESSION_COOKIE=moralenz_admin_session

# Set to "1" only when running against a local http:// Laravel instance, so the
# session cookie is not marked Secure. NEVER set this in production.
ALLOW_INSECURE_COOKIE=0
