###############################################################################
# Mora Lenz — public site (University of Moratuwa server)
#
# Copy this file to .env and fill in the real values.
# Run `php artisan key:generate` once, before the first deploy.
###############################################################################

APP_NAME="Mora Lenz"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Colombo

# No trailing slash. This is used to build every image URL, so it must be the
# exact public address of the site.
APP_URL=https://moralenz.vh25.uom.lk

###############################################################################
# Database — the LOCALHOST user (moralenz_web1)
#
# Use the localhost-only account here. The moralenz_admin@% account exists for
# remote tools such as phpMyAdmin; the site itself never needs remote access.
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moralenz_web
DB_USERNAME=moralenz_web1
DB_PASSWORD=

###############################################################################
# Admin panel (hosted on Vercel)
#
# ADMIN_PANEL_ORIGINS is a comma separated allow-list of origins that may call
# /api/admin/*. No trailing slashes. Anything not listed here is blocked by CORS.
###############################################################################

ADMIN_PANEL_ORIGINS=https://moralenz-admin.vercel.app,http://localhost:3000

# How long an admin stays signed in before the panel asks for the password again.
ADMIN_TOKEN_LIFETIME_HOURS=12

###############################################################################
# The one hard-coded super admin
#
# Set these BEFORE running `php artisan db:seed`. The seeder creates this
# account once; after that it never touches the password again, so you can
# change it from inside the admin panel safely.
#
# Use a long password. There is no "forgot password" flow by design — if it is
# lost, a new one has to be set directly in the database.
###############################################################################

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=uommediaunit@gmail.com
SUPER_ADMIN_PASSWORD=

###############################################################################
# One-time installer  (delete the value again once setup is done!)
#
# CWP gives you FTP but usually no SSH, so you cannot run `php artisan migrate`.
# Instead: put a long random string here, visit
#
#     https://your-site/setup/THAT-STRING
#
# once, and it will generate APP_KEY, create the tables and the super admin.
# Then come back here, set SETUP_KEY= (empty) and re-upload this file.
#
# While this is filled in, anyone who guesses the URL can re-run setup.
# Leave it EMPTY at all other times — an empty value disables the route.
###############################################################################

SETUP_KEY=

###############################################################################
# Uploads
###############################################################################

# Largest image the admin panel may upload, in kilobytes (8192 = 8 MB).
UPLOAD_MAX_KB=8192

###############################################################################
# Contact form
#
# Messages are always saved to the database and readable from the admin panel.
# Set CONTACT_MAIL_ENABLED=true only if SMTP below is working, otherwise leave
# it false — a failed send is logged, never shown to the visitor.
###############################################################################

CONTACT_MAIL_ENABLED=false
CONTACT_MAIL_TO=uommediaunit@gmail.com

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@moralenz.vh25.uom.lk"
MAIL_FROM_NAME="Mora Lenz"

###############################################################################
# Site content links (shown in the footer and contact section)
###############################################################################

CONTACT_EMAIL=uommediaunit@gmail.com
SOCIAL_FACEBOOK=https://www.facebook.com/moralenzuom
SOCIAL_INSTAGRAM=https://www.instagram.com/moralenzuom
SOCIAL_LINKEDIN=https://lk.linkedin.com/company/moralenzuom
MAP_URL=https://maps.app.goo.gl/JAh566G7oQiKNXUp9

###############################################################################
# Framework internals — leave as-is unless you know you need to change them.
###############################################################################

LOG_CHANNEL=stack
LOG_LEVEL=error
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public_uploads
